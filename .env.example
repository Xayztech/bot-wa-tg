# WhatsApp Configuration
WA_SESSION_NAME=xayz_session
WA_PREFIX=.

# Telegram Configuration
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_PREFIX=/

# Gemini API Keys (up to 6)
GEMINI_KEY_1=your_gemini_key_1
GEMINI_KEY_2=your_gemini_key_2
GEMINI_KEY_3=your_gemini_key_3
GEMINI_KEY_4=your_gemini_key_4
GEMINI_KEY_5=your_gemini_key_5
GEMINI_KEY_6=your_gemini_key_6

# OpenAI API Keys (up to 6)
OPENAI_KEY_1=your_openai_key_1
OPENAI_KEY_2=your_openai_key_2
OPENAI_KEY_3=your_openai_key_3
OPENAI_KEY_4=your_openai_key_4
OPENAI_KEY_5=your_openai_key_5
OPENAI_KEY_6=your_openai_key_6

# Bot Owner
OWNER_NUMBER=628xxxxxxxxxx
OWNER_NAME=Xayz Dev

# Features
ENABLE_AUTO_AI=true
ENABLE_AUTO_DOWNLOAD=true
ENABLE_STATUS_REPLY=true
